# ============================================================================
# MQProxy Git 忽略规则
#
# 原则：只忽略本地生成物、运行时产物与敏感信息。
# 以下内容属于项目交付物 / 受管依赖，禁止加入忽略规则：
#   - 3d-partys/              受管第三方库（csv.hpp / glob / nlohmann / tomlplusplus /
#                             catch2 / cpp-httplib / cxxopts）
#   - config.example.toml     配置模板（config.toml 才忽略）
#   - docs/reports/           项目正式测试报告
#   - changelog/              按日变更日志
#   - apps/ common/ services/ web/    重构后的源码与静态资源
#   - .github/workflows/      CI 工作流配置（团队共享）
#   - tests/kafka/*.py、tests/e2e/*.js|py|json   测试脚本与配置；
#     package-lock.json、quarantine.json 为 E2E 必需文件，不可忽略
# ============================================================================

# ----------------------------------------------------------------------------
# 构建输出目录（CMake / Visual Studio 生成，可随时重建）
# ----------------------------------------------------------------------------
build/
build-verify/
cmake-build-*/
bin/
lib/
out/
Debug/
Release/
x64/
Win32/
CMakeFiles/
_deps

# CMake 本地缓存与用户定制配置（CMakePresets.json 属团队共享，不忽略）
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
CMakeUserPresets.json
CMakeSettings.json

# 编译中间产物与二进制（正常位于 build*/ 下，此处防止手工散落到源码根目录）
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.tlog
*.recipe
*.lastbuildstate
*.exe
*.dll
*.lib

# ----------------------------------------------------------------------------
# 本地运行配置与敏感信息（含 SASL 密码 / SSL 私钥，严禁入库）
# config.example.toml 是模板，必须保留；*.pem / *.key / *.crt 等为凭据与证书。
# ----------------------------------------------------------------------------
config.toml
.env
.env.*
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore

# ----------------------------------------------------------------------------
# 运行时日志（日志目录由配置 outdir 指定，文件名按天生成）
# ----------------------------------------------------------------------------
logs/
*.log

# ----------------------------------------------------------------------------
# SQLite 动态配置库（首次启动由 config.toml 种子自动创建，运行期数据不入库）
# 项目当前使用 .db；额外覆盖 sqlite/sqlite3 后缀变体，防止手工改名后漏忽略。
# ----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# ----------------------------------------------------------------------------
# Python 测试缓存与虚拟环境（tests/kafka、tests/e2e 脚本运行产生）
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
.cache/

# ----------------------------------------------------------------------------
# Kafka 测试运行时产物（本地 broker 生成文件与 E2E 报告，可再生成；
# 正式测试报告在 docs/reports/，不受此规则影响）
# ----------------------------------------------------------------------------
tests/kafka/generated/
tests/kafka/reports/

# ----------------------------------------------------------------------------
# Node.js 与 Playwright E2E 产物
# npm install / playwright test / MCP 探索与看板脚本生成，全部可再生成。
# test-results/ 与 metrics/ 为非锚定规则，覆盖 tests/e2e/ 下的实际目录。
# ----------------------------------------------------------------------------
node_modules/
npm-debug.log*
test-results/
playwright-report/
blob-report/
tests/e2e/metrics/
.playwright-mcp/

# ----------------------------------------------------------------------------
# 覆盖率与通用测试产物
# ----------------------------------------------------------------------------
coverage/
.coverage
.coverage.*
htmlcov/
*.trx
TestResults/

# ----------------------------------------------------------------------------
# 编辑器与 IDE 本地状态（版本相关的用户文件，非团队共享配置）
# ----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.iml
.history/
*.swp
*.swo
*.swn
*~
*.orig
*.rej
*.sublime-workspace

# ----------------------------------------------------------------------------
# 操作系统文件与临时/备份文件（跨平台通用）
# ----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.backup
*.old
